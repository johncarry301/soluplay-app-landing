{
  "name": "soluplay-app-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone SoluPlay Free TV app download landing page (Android + Android TV).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node scripts/test-download-flow.mjs",
    "test:preview": "npm run build && node scripts/test-download-flow.mjs --preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
